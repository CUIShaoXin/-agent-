# Required secret. Configure it in the hosting platform; never commit a real key.
DASHSCOPE_API_KEY=

# DashScope chat and embedding models.
MODEL_NAME=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Local defaults. Docker overrides these with /app absolute paths.
KNOWLEDGE_SOURCE_DIR=knowledge_base/docs
KNOWLEDGE_DOCS_DIR=knowledge_base/docs
CHROMA_PERSIST_DIR=knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=huachen_enterprise

# If the collection already contains data it is loaded directly. If it is
# missing or empty, the documents are parsed, embedded and persisted once.
KNOWLEDGE_AUTO_BUILD=true
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MIN_SCORE=0.45

AGENT_DB_PATH=data/agent.db
AGENT_CONTEXT_MESSAGES=12
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000,https://cuishaoxin.github.io
