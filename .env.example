OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.6-terra
AGENT_DB_PATH=data/agent.db
AGENT_MAX_STEPS=6
AGENT_CONTEXT_MESSAGES=12

# 企业离线知识库：DashScope text-embedding-v3 + ChromaDB
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
KNOWLEDGE_SOURCE_DIR=C:\Users\cui\Desktop\clothing_company_knowledge_base
KNOWLEDGE_DOCS_DIR=knowledge_base/docs
CHROMA_DB_PATH=knowledge_base/chroma_db
CHROMA_COLLECTION_NAME=huachen_enterprise
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_AUTO_BUILD=true
RAG_TOP_K=5
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760

# MySQL 请使用只读账号；MYSQL_ALLOWED_TABLES 留空表示允许当前数据库中的全部业务表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent_readonly
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=enterprise
MYSQL_ALLOWED_TABLES=products,faqs,orders
MYSQL_MAX_ROWS=100

# 逗号分隔；生产环境填写真实前端 origin。
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://cuishaoxin.github.io
